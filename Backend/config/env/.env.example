NODE_ENV=development
PORT=3000

# Prefer DATABASE_URL in production when available.
DATABASE_URL=
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=task_tracker
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL=false

JWT_SECRET=replace-with-strong-32-plus-char-secret
JWT_EXPIRES_IN=7d

# Comma separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
TRUST_PROXY=loopback

# Optional integrations
IPINFO_TOKEN=
EMAIL_PROVIDER=smtp
EMAIL_USER=
EMAIL_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_TIMEOUT_MS=10000
SMTP_IP_FAMILY=4
OTP_SEND_ASYNC_ON_REGISTER=true
OTP_FAIL_OPEN_ON_REGISTER=true
RESEND_API_KEY=
OTP_FROM_EMAIL=no-reply@tasktracker.local
UI_APP_URL=http://localhost:3001

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
