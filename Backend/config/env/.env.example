NODE_ENV=development
PORT=3000

# Prefer DATABASE_URL in production when available.
DATABASE_URL=
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=task_tracker
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL=false

JWT_SECRET=replace-with-strong-32-plus-char-secret
JWT_EXPIRES_IN=7d
CHAT_MESSAGE_ENCRYPTION_KEY=

# Comma separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
TRUST_PROXY=loopback

# Rate limiting
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_LIMIT=300
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_LIMIT=40
RATE_LIMIT_AI_WINDOW_MS=60000
RATE_LIMIT_AI_LIMIT=40
RATE_LIMIT_SEARCH_WINDOW_MS=60000
RATE_LIMIT_SEARCH_LIMIT=90
RATE_LIMIT_DASHBOARD_WINDOW_MS=60000
RATE_LIMIT_DASHBOARD_LIMIT=60
RATE_LIMIT_CHAT_READ_WINDOW_MS=60000
RATE_LIMIT_CHAT_READ_LIMIT=120
RATE_LIMIT_CHAT_WRITE_WINDOW_MS=60000
RATE_LIMIT_CHAT_WRITE_LIMIT=45
RATE_LIMIT_PROJECT_READ_WINDOW_MS=60000
RATE_LIMIT_PROJECT_READ_LIMIT=90

# Optional integrations
IPINFO_TOKEN=
EMAIL_PROVIDER=smtp
EMAIL_USER=
EMAIL_PASS=
SMTP_SERVICE=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_TIMEOUT_MS=10000
SMTP_IP_FAMILY=4
EMAIL_HTTP_TIMEOUT_MS=10000
OTP_SEND_ASYNC_ON_REGISTER=true
OTP_FAIL_OPEN_ON_REGISTER=true
REGISTER_METADATA_ASYNC=true
RESEND_API_KEY=
OTP_FROM_EMAIL=no-reply@tasktracker.local
# Single frontend URL used in emails and redirects
UI_APP_URL=http://localhost:3001

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI assistant provider (auto | gemini | ollama)
AI_PROVIDER=auto
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_ASSISTANT_BASE_URL=http://127.0.0.1:8787
AI_ASSISTANT_API_KEY=
AI_TIMEOUT_MS=20000
