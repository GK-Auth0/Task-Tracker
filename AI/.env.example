AI_ENV=development
AI_ASSISTANT_HOST=127.0.0.1
AI_ASSISTANT_PORT=8787

# Optional hardening
AI_MAX_BODY_BYTES=1048576
AI_ALLOWED_ORIGINS=*
AI_API_KEY=

# Chat provider
# rule-based | gemini | auto
AI_CHAT_PROVIDER=rule-based
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SEC=12
