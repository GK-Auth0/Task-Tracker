# Backend API base URL
# - Development example: http://localhost:3000
# - Production: set explicit API domain, or leave empty to use same-origin reverse proxy
VITE_API_BASE_URL=http://localhost:3000

# Chat websocket base URL
# - Development example: ws://localhost:3000
# - Production example: wss://api.example.com
VITE_WS_BASE_URL=ws://localhost:3000

# AI assistant service base URL
# - Development example: http://127.0.0.1:8787
# - Production: set explicit AI service URL, or route "/ai-assistant" to AI backend and leave empty
VITE_AI_ASSISTANT_URL=http://127.0.0.1:8787

# Auth0 (optional)
# Set to true/yes/1 to hide Auth0 buttons on auth pages.
VITE_HIDE_AUTH0=false
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
